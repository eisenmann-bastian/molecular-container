rule all:
    input:
        "output/uppercase.txt"


rule write_greeting:
    input:
        "greeting.txt"
    output:
        "output/greeting.txt"
    shell:
        "cp {input:q} {output:q}"


rule uppercase_greeting:
    input:
        "output/greeting.txt"
    output:
        "output/uppercase.txt"
    shell:
        "tr '[:lower:]' '[:upper:]' < {input:q} > {output:q}"
